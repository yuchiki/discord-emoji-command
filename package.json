{
  "main": "src/index.ts",
  "scripts": {
    "start": "FONTCONFIG_FILE=$PWD/fonts/fonts.conf bun run src/index.ts",
    "test": "FONTCONFIG_FILE=$PWD/fonts/fonts.conf bun test src/",
    "format": "biome format --write src/",
    "lint": "biome lint src/",
    "check": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t emoji-command .",
    "docker:run": "bun run docker:build && docker run --env-file .env emoji-command"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tsconfig/strictest": "^2.0.9",
    "@types/bun": "latest",
    "typescript": "5.9.3"
  }
}
